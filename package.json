{
  "name": "react-libraries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "pnpm content && blume dev",
    "build": "pnpm content && blume build",
    "check": "pnpm content && blume check",
    "doctor": "pnpm content && blume doctor",
    "preview": "blume preview",
    "content": "node scripts/build-content.ts",
    "test": "pnpm test:catalog && playwright test",
    "test:catalog": "pnpm content && node --test tests/catalog.node.ts",
    "validate": "blume validate --strict"
  },
  "dependencies": {
    "blume": "2.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
