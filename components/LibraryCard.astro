---
import { getLibrary } from "../content/catalog.ts";
interface Props { libraryId: string; }
const library = getLibrary(Astro.props.libraryId);
---
<section id={`library-${library.id}`} class="library-card not-prose" aria-label={library.name} data-pagefind-ignore>
  <div class="library-heading">
    <span class="library-monogram" aria-hidden="true">{library.monogram}</span>
    <h3><a href={`/${library.category}/${library.id}`}>{library.name}</a></h3>
    <span class="library-kind">{library.kind}</span>
  </div>
  <p class="library-description">{library.description}</p>
  <dl class="library-facts">
    <div><dt>Good for</dt><dd>{library.goodFor}</dd></div>
    {library.caveat && <div><dt>Keep in mind</dt><dd>{library.caveat}</dd></div>}
  </dl>
  <div class="library-links">
    <a class="library-overview" href={`/${library.category}/${library.id}`}>Read overview <span aria-hidden="true">→</span></a>
    <a class="library-official" href={library.official} target="_blank" rel="noreferrer">{library.sourceStatus === "unavailable" ? "Saved source" : "Visit source"} <span aria-hidden="true">↗</span><span class="sr-only"> for {library.name} (opens in a new tab)</span></a>
  </div>
</section>
