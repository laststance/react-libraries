---
import { categories } from "../content/catalog.ts";
import Icon from "blume/components/Icon.astro";

interface Props {
  group: string;
  tasks?: boolean;
}

const { group, tasks = false } = Astro.props;
const entries = categories.filter((category) => category.group === group);
---
<ul class="category-grid not-prose" role="list">
  {entries.map((category) => (
    <li>
      <a class="category-entry" href={tasks ? `/tasks/${category.taskId}` : `/${category.id}`}>
        <Icon name={category.icon} size={17} />
        <span>{tasks ? category.task : category.title}</span>
        <Icon name="arrow-right" size={15} />
      </a>
    </li>
  ))}
</ul>
